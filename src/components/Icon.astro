}

const { name, class: className = "icon-sm" } = Astro.props
const icon: { alt: string, path: string, fill?: string, viewBox?: string } = ICONS[name]
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  fill={icon.fill}
  viewBox={icon.viewBox ?? "0 0 24 24"}
  stroke-width="1.5"
  stroke="currentColor"
  class={className}
  aria-label={icon.alt}
  set:html={icon.path}
/>
