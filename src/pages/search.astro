---
import Layout from "~/layouts/Layout.astro"
import SearchPanel from "~/components/SearchPanel.astro"
import SeoTags from "~/components/SeoTags.astro"
import { SITE_NAME, absoluteUrl, titleize } from "~/lib/site"
---

<Layout>
  <Fragment slot="head">
    <title>{titleize("Search")}</title>
    <SeoTags title="Search" description={`Search the articles, talks and snaps by ${SITE_NAME}`} url={absoluteUrl("/search")} />
    <meta name="robots" content="noindex" />
  </Fragment>

  <h1 class="visually-hidden">Search</h1>
  <SearchPanel />
</Layout>
