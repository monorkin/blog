{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [ "nodejs_compat" ],
  // stanko.io itself; media.stanko.io is R2's. A route, not a custom domain, so the DNS
  // record stays as it is, and taking the route out sends the domain back to its server.
  "routes": [
    { "pattern": "stanko.io/*", "zone_name": "stanko.io" }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Static files answer first, except the feeds' own URLs, whose first page the Worker
    // serves, and the old feed URLs it redirects (src/worker.ts)
    "run_worker_first": [ "/feed", "/articles/feed", "/talks/feed", "/snaps/feed", "/articles/atom", "/articles/rss" ]
  },
  "observability": {
    "enabled": true
  }
}
