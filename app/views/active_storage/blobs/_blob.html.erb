<%
  size_limit = local_assigns[:in_gallery] ? [ 800, 600 ] : [ 1024, nil ]
  image_options = { resize_to_limit: size_limit, saver: { strip: true } }
  width, height = blob.full_attributes.values_at("width", "height").map(&:to_i)
  classes = %w[attachment]
  data = {}

  classes << "attachment--#{blob.representable? ? "preview" : "file"}"
  classes << "attachment--#{blob.filename.extension}"

  if blob.image? && !local_assigns[:in_gallery] && height > width
    classes << "attachment--expandable"
    data.merge!(controller: "toggle-class", action: "click->toggle-class#toggle", toggle_class_active_class: "attachment--expanded")
  end
%>

<%= content_tag(:figure, class: classes, data: data) do %>
  <% if blob.video? %>
    <% poster = blob.representable? ? url_for(blob.representation(image_options)) : false %>
    <% options = { controls: true, autoplay: "autoplay", playsinline: true, loop: true, muted: true, loading: "lazy" } %>
    <% options.merge!(poster: url_for(poster), poster_skip_pipeline: true) if poster %>

    <%= video_tag([url_for(blob)], options) %>
  <% elsif blob.audio? %>
    <%= audio_tag([url_for(blob)], autoplay: false, controls: true) %>
  <% elsif blob.content_type == "application/pdf" %>
    <%= content_tag(:embed, src: rails_blob_url(blob), width: 800, height: 500, type: "application/pdf") %>
  <% elsif blob.representable? %>
    <% alt = blob.try(:caption).presence || blob.filename.base %>

    <% if blob.filename.extension == "gif" %>
      <%= attachment_image_tag url_for(blob), alt: alt, size: [ width, height ] %>
    <% else %>
      <%= attachment_image_tag blob.representation(image_options), alt: alt, size: resized_image_size(width, height, size_limit) %>
    <% end %>
  <% else %>
    <%= link_to blob.filename, url_for(blob), download: true %>
  <% end %>

  <figcaption class="attachment__caption">
    <% if caption = blob.try(:caption) %>
      <%= caption %>
    <% else %>
      <span class="attachment__name"><%= blob.filename %></span>
      <span class="attachment__size"><%= number_to_human_size blob.byte_size %></span>
    <% end %>
  </figcaption>
<% end %>
