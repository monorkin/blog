---
import type { GetStaticPaths } from "astro"
import Layout from "~/layouts/Layout.astro"
import SeoTags from "~/components/SeoTags.astro"
import Paginated from "~/components/Paginated.astro"
import SnapGridItem from "~/components/SnapGridItem.astro"
import FeedLink from "~/components/FeedLink.astro"
import { publishedEntries, type Entry } from "~/lib/entries"
import { pagePath, paginateIndex, type IndexPage } from "~/lib/pagination"
import { absoluteUrl, titleize } from "~/lib/site"

export const getStaticPaths = (async ({ paginate }) => {
  return paginateIndex(paginate, await publishedEntries("snap"), "/snaps")
}) satisfies GetStaticPaths

const { page } = Astro.props as { page: IndexPage<Entry> }
const snaps = await publishedEntries("snap")

function yearOf(snap: Entry) {
  return snap.publishedAt.getUTCFullYear()
}

function startsYear(snap: Entry) {
  const previous = snaps[snaps.findIndex(candidate => candidate.path === snap.path) - 1]
  return !previous || yearOf(previous) !== yearOf(snap)
}

// A section per year. A page that starts partway through a year continues the last page's
// section, without a heading, and src/scripts/snaps.ts joins the two when it loads that page.
function sectionsOf(pageSnaps: Entry[]) {
  const sections: { year: number, snaps: Entry[], continued: boolean }[] = []

  for (const snap of pageSnaps) {
    if (startsYear(snap) || sections.length === 0) {
      sections.push({ year: yearOf(snap), snaps: [ snap ], continued: !startsYear(snap) })
    } else {
      sections.at(-1)!.snaps.push(snap)
    }
  }

  return sections
}
---

<Layout section="snaps" transitions>
  <Fragment slot="head">
    <title>{titleize("Snaps")}</title>
    <SeoTags
      title="Snaps"
      description="Photos and videos by Stanko from travels, hikes and everyday life: landscapes, cities and whatever caught my eye along the way."
      url={absoluteUrl(pagePath("/snaps", page.number))}
    />
  </Fragment>

  <div class="photos-section">
    <div class="article margin-block-end-4">
      <div class="feed-heading">
        <h1 class="txt-4xl font-semibold">Snaps</h1>
        <FeedLink kind="snap" />
      </div>
      <p class="txt-muted">
        Photos and videos I've taken on travels, hikes and everyday life.
      </p>
    </div>

    {page.data.length > 0 && (
      <Paginated page={page}>
        {sectionsOf(page.data).map(section => (
          <section class:list={[ "snap-year", { "snap-year--continued": section.continued } ]}>
            {!section.continued && <h2 class="snap-year__title">{section.year}</h2>}
            <div class="photos-grid photos-grid--justified">
              {section.snaps.map(snap => <SnapGridItem snap={snap} />)}
            </div>
          </section>
        ))}
      </Paginated>
    )}
    {page.data.length === 0 && (
      <div class="article">
        <p class="txt-muted">No snaps yet</p>
      </div>
    )}
  </div>

  <dialog id="snap-lightbox" class="lightbox" aria-label="snap_lightbox">
    <div class="dialog__frame"></div>
  </dialog>

  <script>
    import "~/scripts/snaps"
  </script>
</Layout>
