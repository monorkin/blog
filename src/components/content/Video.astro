---
import { findMedia, mediaFolderFor, originalUrl, placeholderStyle, posterFor, resolveMediaKey, variantAtLeast } from "~/lib/media"

interface Props {
  media: string
  // Both come from the video when left out: its type from the manifest, and its poster is
  // the image beside it with the same name (posterFor)
  type?: string
  poster?: string
  caption?: string
  // A short clip that plays like a GIF: no controls
  clip?: boolean
}

const POSTER_WIDTH = 1200

const { caption = "", clip = false } = Astro.props
const folder = mediaFolderFor(Astro)
const media = resolveMediaKey(Astro.props.media, folder)
const extension = media.split(".").pop()!.toLowerCase()
const video = findMedia(media)
const type = Astro.props.type ?? video.type

let posterKey
if (Astro.props.poster) {
  posterKey = resolveMediaKey(Astro.props.poster, folder)
} else {
  posterKey = posterFor(media)
}
const posterUrl = variantAtLeast(posterKey, POSTER_WIDTH)
const placeholder = placeholderStyle(posterKey)
---

<figure class={`attachment attachment--preview attachment--${extension}`}>
  <video class:list={[ "attachment__image--sized", { placeholder } ]} style={`--attachment-width: ${video.width}; --attachment-height: ${video.height}; ${placeholder ?? ""}`} controls={!clip} autoplay playsinline loop muted poster={posterUrl} width={video.width} height={video.height}>
    <source src={originalUrl(media)} type={type} />
  </video>
  <figcaption class="attachment__caption">{caption}</figcaption>
</figure>
