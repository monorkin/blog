#!/usr/bin/env node
// Uploaded media lives outside git: originals in media/originals/, served from R2 in production.
//
//   bin/media variants          make a poster for any video without one, strip metadata from
//                               originals, make the responsive variants and write
//                               src/data/media.json
//   bin/media sync [--dry-run]  copy media/originals and media/variants to R2, refusing any
//                               original that still has location data
//   bin/media pull              fetch the originals from R2 into media/originals
//   bin/media serve [--port N]  serve media/ locally, as bin/preview does
//
// sync and pull talk to R2 through rclone and its S3 API. R2_ACCOUNT_ID and R2_BUCKET come
// from .mise.toml. The keys, R2_ACCESS_KEY_ID and R2_SECRET_ACCESS_KEY, are used from the
// environment when they're set, as in CI; otherwise these two commands run themselves again
// under `op run`, which reads them from 1Password through .env.1password. Nothing else here
// touches 1Password, sync --dry-run included.
import { existsSync } from "node:fs"
import { mkdir, readdir, readFile, rename, rm, stat, utimes, writeFile } from "node:fs/promises"
import { createServer } from "node:http"
import { dirname, extname, join, relative, sep } from "node:path"
import { spawnSync } from "node:child_process"
import { fileURLToPath } from "node:url"
import sharp from "sharp"
import { mediaHandler } from "../lib/media-server.js"

const ROOT = join(dirname(fileURLToPath(import.meta.url)), "..")
const MEDIA = join(ROOT, "media")
const ORIGINALS = join(MEDIA, "originals")
const VARIANTS = join(MEDIA, "variants")
const MANIFEST = join(ROOT, "src/data/media.json")

const WIDTHS = [ 480, 800, 1200, 1600, 2400 ]
const PROFILES = [
  { prefix: "link-previews/", widths: [ 400, 768 ], squares: [] },
  { prefix: "snaps/", widths: WIDTHS, squares: [ 400, 512, 800 ] },
  { prefix: "", widths: WIDTHS, squares: [ 512 ] }
]
const FALLBACK_FORMATS = { jpeg: "jpeg", jpg: "jpeg", png: "png", webp: null }
const VIDEO_TYPES = { ".mp4": "video/mp4", ".webm": "video/webm", ".mov": "video/quicktime" }
const IMAGE_TYPES = { jpeg: "image/jpeg", png: "image/png", webp: "image/webp", gif: "image/gif", svg: "image/svg+xml" }
const EXTENSIONS = { jpeg: "jpg", png: "png", webp: "webp" }
const STRIPPABLE_IMAGES = new Set([ ".jpg", ".jpeg", ".png", ".webp" ])
const POSTER_EXTENSIONS = [ ".jpg", ".jpeg", ".png", ".webp" ]
// A poster comes from a fifth of the way in, past a black or title-card opening, as the best
// of the next this many frames by ffmpeg's thumbnail filter
const POSTER_POSITION = 0.2
const POSTER_CANDIDATES = 150
const ORIENTATION_KEY = "Exif.Image.Orientation"
// Tags a remux writes itself, which say nothing about who made the video or where
const HARMLESS_VIDEO_TAGS = new Set([ "major_brand", "minor_version", "compatible_brands", "handler_name", "vendor_id", "language", "DURATION" ])
const LOCATION_TAG = /GPS|location|ISO6709|City|Country|Sublocation|ProvinceState/i
const PLACEHOLDER_SIZE = 16
const PLACEHOLDER_QUALITY = 30
const CONCURRENCY = 4
const SERVE_PORT = 4322
const R2_CACHE_CONTROL = "public, max-age=31536000"
const R2_KEYS = [ "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY" ]
const ONE_PASSWORD_ENV_FILE = join(ROOT, ".env.1password")
// Stanko's personal account; a work account is signed in beside it
const ONE_PASSWORD_ACCOUNT = "my.1password.eu"
const UNDER_ONE_PASSWORD = "BIN_MEDIA_UNDER_OP_RUN"

const commands = {
  variants: makeVariants,
  sync: syncToR2,
  pull: pullFromR2,
  serve: serveLocally
}

const [ command, ...options ] = process.argv.slice(2)

if (commands[command]) {
  await commands[command](options)
} else {
  console.error("Usage: bin/media variants | sync [--dry-run] | pull | serve [--port N]")
  process.exit(1)
}

// Variants

async function makeVariants() {
  const posters = await makeMissingPosters()
  const files = await originals()
  const previous = await previousManifest()
  const manifest = {}
  let made = 0
  let stripped = 0

  await eachInParallel(files, async file => {
    const key = toKey(file)

    if (await stripMetadata(file)) {
      stripped += 1
    }

    const entry = await describe(file)

    if (entry.formats) {
      const count = await writeVariants(file, key, entry)
      made += count
      Object.assign(entry, await placeholderFor(key, entry, previous[key]))
    }

    manifest[key] = entry
  })

  await pruneVariants(new Set(Object.keys(manifest)))
  await writeFile(MANIFEST, JSON.stringify(sortedByKey(manifest), null, 2) + "\n")

  console.log(`${files.length} originals, ${posters} posters made, ${stripped} stripped of metadata, ${made} variants made, manifest in ${relative(ROOT, MANIFEST)}`)
}

// A video's poster is the image beside it with the same name, "demo.jpg" for "demo.mp4"
// (src/lib/media.ts), so a video without one gets a frame of itself
async function makeMissingPosters() {
  const videos = (await originals()).filter(file => VIDEO_TYPES[extname(file).toLowerCase()])
  const missing = videos.filter(video => !POSTER_EXTENSIONS.some(extension => existsSync(withoutExtension(video) + extension)))

  for (const video of missing) {
    const poster = withoutExtension(video) + ".jpg"
    const start = (videoDetails(video).duration ?? 0) * POSTER_POSITION

    run("ffmpeg", [ "-v", "error", "-ss", String(start), "-i", video, "-vf", `thumbnail=${POSTER_CANDIDATES}`, "-frames:v", "1", "-q:v", "3", poster ])
    console.log(`Made a poster for ${relative(ROOT, video)}: ${relative(ROOT, poster)}`)
  }

  return missing.length
}

function withoutExtension(file) {
  return file.slice(0, -extname(file).length)
}

// Originals are public on R2, and a photo or video straight off a phone says where it was
// taken, with what, and when. Everything but the orientation goes, without re-encoding:
// exiv2 for images (it keeps the colour profile), a remux for videos. The file keeps its
// modification time, so its variants aren't made again.
async function stripMetadata(file) {
  const { atime, mtime } = await stat(file)
  let stripped = false

  if (VIDEO_TYPES[extname(file).toLowerCase()]) {
    stripped = videoTags(file).some(([ key, value ]) => !isHarmlessVideoTag(key, value))

    if (stripped) {
      await remuxWithoutMetadata(file)
    }
  } else if (STRIPPABLE_IMAGES.has(extname(file).toLowerCase())) {
    stripped = imageMetadataKeys(file).some(key => key !== ORIENTATION_KEY) || hasImageComment(file)

    if (stripped) {
      await removeImageMetadata(file)
    }
  }

  if (stripped) {
    await utimes(file, atime, mtime)
  }

  return stripped
}

function videoTags(file) {
  const result = spawnSync("ffprobe", [ "-v", "error", "-show_entries", "format_tags:stream_tags", "-of", "json", file ], { encoding: "utf8" })
  const probe = JSON.parse(result.stdout)

  return [ probe.format, ...(probe.streams ?? []) ].flatMap(part => Object.entries(part?.tags ?? {}))
}

// A remux names ffmpeg as the encoder; any other encoder is the app that made the video
function isHarmlessVideoTag(key, value) {
  if (/^encoder$/i.test(key)) {
    return /^Lav[fc]/.test(value)
  } else {
    return HARMLESS_VIDEO_TAGS.has(key)
  }
}

async function remuxWithoutMetadata(file) {
  const remuxed = `${file}.remuxed${extname(file)}`
  const flags = [ "-map", "0", "-c", "copy", "-map_metadata", "-1", "-map_metadata:s", "-1", "-map_chapters", "-1", "-fflags", "+bitexact" ]

  if ([ ".mp4", ".mov" ].includes(extname(file).toLowerCase())) {
    flags.push("-movflags", "+faststart")
  }

  run("ffmpeg", [ "-v", "error", "-y", "-i", file, ...flags, remuxed ])
  await rename(remuxed, file)
}

function imageMetadataKeys(file) {
  return spawnSync("exiv2", [ "-q", "-PEIXk", file ], { encoding: "utf8" }).stdout.split("\n").map(key => key.trim()).filter(Boolean)
}

function hasImageComment(file) {
  return spawnSync("exiv2", [ "-q", "-pc", file ], { encoding: "utf8" }).stdout.trim() !== ""
}

async function removeImageMetadata(file) {
  const { orientation = 1 } = await sharp(file).metadata()

  run("exiv2", [ "-q", "-d", "a", file ])

  if (orientation > 1) {
    run("exiv2", [ "-q", "-M", `set ${ORIENTATION_KEY} Short ${orientation}`, file ])
  }
}

function run(command, args) {
  const result = spawnSync(command, args, { stdio: [ "ignore", "ignore", "inherit" ] })

  if (result.error || result.status !== 0) {
    console.error(`${command} failed on ${relative(ROOT, args.at(-1))}. bin/setup installs ffmpeg and exiv2.`)
    process.exit(1)
  }
}

async function describe(file) {
  const bytes = (await stat(file)).size
  const videoType = VIDEO_TYPES[extname(file).toLowerCase()]

  if (videoType) {
    return { type: videoType, bytes, ...videoDetails(file) }
  } else {
    const metadata = await sharp(file).metadata()
    const [ width, height ] = orientedSize(metadata)
    const entry = { type: IMAGE_TYPES[metadata.format], bytes, width, height }

    if (metadata.format in FALLBACK_FORMATS) {
      const profile = profileFor(toKey(file))
      entry.formats = [ "webp", FALLBACK_FORMATS[metadata.format] ].filter(Boolean)
      entry.widths = widthsFor(width, profile.widths)
      entry.squares = profile.squares.filter(size => size <= Math.min(width, height))
    }

    return entry
  }
}

// The size a video displays at, rotation included, so the page can make room for it, and
// how long it runs, in whole seconds (some WebM files don't say, and get none)
function videoDetails(file) {
  const result = spawnSync("ffprobe", [ "-v", "error", "-select_streams", "v:0", "-show_entries", "stream=width,height,sample_aspect_ratio:stream_side_data=rotation:format=duration", "-of", "json", file ], { encoding: "utf8" })

  if (result.status === 0) {
    const probe = JSON.parse(result.stdout)
    const stream = probe.streams[0]
    const rotation = Math.abs(stream.side_data_list?.find(data => "rotation" in data)?.rotation ?? 0)
    const [ width, height ] = displaySize(stream)
    const seconds = Number(probe.format?.duration)
    let duration
    if (Number.isFinite(seconds)) {
      duration = Math.round(seconds)
    }

    if (rotation === 90 || rotation === 270) {
      return { width: height, height: width, duration }
    } else {
      return { width, height, duration }
    }
  } else {
    console.error(`ffprobe couldn't read ${relative(ROOT, file)}. Is ffmpeg installed? bin/setup installs it.`)
    process.exit(1)
  }
}

// Pixels that aren't square stretch the picture; browsers stretch it the way that doesn't
// lose any, so a narrow pixel makes the video taller rather than narrower
function displaySize({ width, height, sample_aspect_ratio }) {
  const [ numerator, denominator ] = (sample_aspect_ratio ?? "1:1").split(":").map(Number)
  const pixelRatio = numerator / denominator || 1

  if (pixelRatio >= 1) {
    return [ Math.round(width * pixelRatio), height ]
  } else {
    return [ width, Math.round(height / pixelRatio) ]
  }
}

// Phone photos are often stored sideways with an EXIF orientation saying so
function orientedSize({ width, height, orientation }) {
  if (orientation >= 5) {
    return [ height, width ]
  } else {
    return [ width, height ]
  }
}

function profileFor(key) {
  return PROFILES.find(profile => key.startsWith(profile.prefix))
}

// Every standard width below the original, and the original's own width when it's smaller
// than the largest standard one, so the biggest variant is as sharp as the original allows.
function widthsFor(width, widths) {
  const smaller = widths.filter(candidate => candidate < width)

  if (width <= widths.at(-1) && !smaller.includes(width)) {
    return [ ...smaller, width ]
  } else {
    return smaller
  }
}

async function writeVariants(file, key, entry) {
  let made = 0

  for (const format of entry.formats) {
    for (const width of entry.widths) {
      made += await writeVariant(file, variantPath(key, `${width}w`, format), image => image.resize({ width }), format)
    }

    for (const size of entry.squares) {
      made += await writeVariant(file, variantPath(key, `${size}sq`, format), image => image.resize({ width: size, height: size, fit: "cover" }), format)
    }
  }

  return made
}

async function writeVariant(file, path, transform, format) {
  if (await isFresh(path, file)) {
    return 0
  } else {
    await mkdir(dirname(path), { recursive: true })
    await encode(transform(sharp(file).rotate()), format).toFile(path)
    return 1
  }
}

function encode(image, format) {
  switch (format) {
    case "webp": return image.webp({ quality: 80 })
    case "jpeg": return image.jpeg({ quality: 82, mozjpeg: true })
    case "png": return image.png({ compressionLevel: 9 })
  }
}

// A blurred stand-in the page shows while the image loads: a tiny WebP and the average color.
// Made from the smallest variant, which is already the right way up, and kept from the last
// manifest while the original is the same size.
async function placeholderFor(key, entry, previous) {
  if (previous?.placeholder && previous.bytes === entry.bytes) {
    return { placeholder: previous.placeholder, color: previous.color }
  } else {
    const smallest = variantPath(key, `${entry.widths[0]}w`, "webp")
    const tiny = await sharp(smallest).resize(PLACEHOLDER_SIZE, PLACEHOLDER_SIZE, { fit: "inside" }).webp({ quality: PLACEHOLDER_QUALITY }).toBuffer()
    const { channels } = await sharp(tiny).stats()

    return {
      placeholder: `data:image/webp;base64,${tiny.toString("base64")}`,
      color: `#${channels.slice(0, 3).map(channel => Math.round(channel.mean).toString(16).padStart(2, "0")).join("")}`
    }
  }
}

async function previousManifest() {
  if (existsSync(MANIFEST)) {
    return JSON.parse(await readFile(MANIFEST, "utf8"))
  } else {
    return {}
  }
}

function variantPath(key, name, format) {
  return join(VARIANTS, key, `${name}.${EXTENSIONS[format]}`)
}

async function isFresh(path, source) {
  if (existsSync(path)) {
    return (await stat(path)).mtimeMs >= (await stat(source)).mtimeMs
  } else {
    return false
  }
}

async function pruneVariants(keys) {
  if (existsSync(VARIANTS)) {
    for (const file of await filesIn(VARIANTS)) {
      const key = relative(VARIANTS, dirname(file)).split(sep).join("/")

      if (!keys.has(key)) {
        await rm(file)
      }
    }
  }
}

// R2

async function syncToR2(options) {
  const dryRun = options.includes("--dry-run")
  // Stripping keeps a file's modification time, so compare sizes and checksums, not times
  const copy = () => rclone([ "copy", MEDIA, `r2:${requireEnv("R2_BUCKET")}`, "--include", "/originals/**", "--include", "/variants/**",
    "--checksum", "--header-upload", `Cache-Control: ${R2_CACHE_CONTROL}`, "--transfers", "8", ...flagsFor(dryRun) ])

  refuseLocatedOriginals(await originals())

  if (dryRun && hasR2Keys()) {
    copy()
  } else if (dryRun) {
    return describeUpload()
  } else {
    withR2Keys(copy)
  }
}

// Nothing that says where it was taken goes up; bin/media variants strips it
function refuseLocatedOriginals(files) {
  const located = files.filter(file => {
    if (VIDEO_TYPES[extname(file).toLowerCase()]) {
      return videoTags(file).some(([ key ]) => LOCATION_TAG.test(key))
    } else if (STRIPPABLE_IMAGES.has(extname(file).toLowerCase())) {
      return imageMetadataKeys(file).some(key => LOCATION_TAG.test(key))
    } else {
      return false
    }
  })

  if (located.length > 0) {
    console.error(`Not syncing: ${located.length} originals still say where they were taken. Run bin/media variants to strip them.`)
    located.forEach(file => console.error(`  ${relative(ROOT, file)}`))
    process.exit(1)
  }
}

function pullFromR2() {
  withR2Keys(() => rclone([ "copy", `r2:${requireEnv("R2_BUCKET")}/originals`, ORIGINALS, "--transfers", "8", ...flagsFor(false) ]))
}

// Runs `work` with the keys from the environment, or runs this command again under
// `op run` to get them from 1Password
function withR2Keys(work) {
  if (hasR2Keys()) {
    work()
  } else if (process.env[UNDER_ONE_PASSWORD]) {
    console.error(`op run didn't provide ${R2_KEYS.join(" and ")}. Check the 1Password item that .env.1password names (doc/images.md).`)
    process.exit(1)
  } else {
    runUnderOnePassword()
  }
}

function runUnderOnePassword() {
  const result = spawnSync("op", [ "run", "--account", ONE_PASSWORD_ACCOUNT, `--env-file=${ONE_PASSWORD_ENV_FILE}`, "--", process.execPath, ...process.argv.slice(1) ], {
    stdio: "inherit",
    env: { ...process.env, [UNDER_ONE_PASSWORD]: "1" }
  })

  if (result.error) {
    console.error(`Couldn't run the 1Password CLI (${result.error.message}). bin/setup installs it; sign in with 'op signin', or set ${R2_KEYS.join(" and ")} yourself.`)
    process.exitCode = 1
  } else {
    process.exitCode = result.status ?? 1
  }
}

function flagsFor(dryRun) {
  const flags = []

  if (dryRun) {
    flags.push("--dry-run")
  }

  if (process.stdout.isTTY) {
    flags.push("--progress")
  }

  return flags
}

// Without the keys in the environment there's no bucket to compare against, and a dry run
// doesn't ask 1Password, so it says what's here to upload
async function describeUpload() {
  for (const directory of [ ORIGINALS, VARIANTS ]) {
    if (existsSync(directory)) {
      const files = await filesIn(directory)
      const bytes = (await Promise.all(files.map(file => stat(file)))).reduce((sum, { size }) => sum + size, 0)
      console.log(`${relative(ROOT, directory)}: ${files.length} files, ${(bytes / 1048576).toFixed(1)} MiB`)
    } else {
      console.log(`${relative(ROOT, directory)}: missing`)
    }
  }

  console.log(`Would copy to r2:${process.env.R2_BUCKET ?? "(R2_BUCKET isn't set)"} on account ${process.env.R2_ACCOUNT_ID ?? "(R2_ACCOUNT_ID isn't set)"}.`)
  console.log(`${R2_KEYS.join(" and ")} aren't set, so this didn't compare with the bucket. To see exactly what`)
  console.log(`rclone would copy: op run --account ${ONE_PASSWORD_ACCOUNT} --env-file=.env.1password -- bin/media sync --dry-run`)
}

function hasR2Keys() {
  return R2_KEYS.every(name => process.env[name])
}

function rclone(args) {
  const env = {
    ...process.env,
    RCLONE_CONFIG_R2_TYPE: "s3",
    RCLONE_CONFIG_R2_PROVIDER: "Cloudflare",
    RCLONE_CONFIG_R2_ACCESS_KEY_ID: requireEnv("R2_ACCESS_KEY_ID"),
    RCLONE_CONFIG_R2_SECRET_ACCESS_KEY: requireEnv("R2_SECRET_ACCESS_KEY"),
    RCLONE_CONFIG_R2_ENDPOINT: `https://${requireEnv("R2_ACCOUNT_ID")}.r2.cloudflarestorage.com`,
    RCLONE_CONFIG_R2_NO_CHECK_BUCKET: "true"
  }
  const result = spawnSync("rclone", args, { stdio: "inherit", env })

  process.exitCode = result.status ?? 1
}

function requireEnv(name) {
  if (process.env[name]) {
    return process.env[name]
  } else {
    console.error(`${name} isn't set. R2_ACCOUNT_ID and R2_BUCKET come from .mise.toml, so run this where mise is active (or through 'mise exec --').`)
    process.exit(1)
  }
}

// Serving

function serveLocally(options) {
  let port = SERVE_PORT

  if (options.includes("--port")) {
    port = Number(options[options.indexOf("--port") + 1])
  }

  createServer(mediaHandler(MEDIA)).listen(port, "127.0.0.1", () => console.log(`Serving media/ at http://localhost:${port}`))
}

// Files

async function originals() {
  if (existsSync(ORIGINALS)) {
    return (await filesIn(ORIGINALS)).sort()
  } else {
    console.error("media/originals is empty. Fetch it with `bin/media pull`.")
    process.exit(1)
  }
}

async function filesIn(directory) {
  const entries = await readdir(directory, { recursive: true, withFileTypes: true })
  return entries.filter(entry => entry.isFile()).map(entry => join(entry.parentPath, entry.name))
}

function toKey(file) {
  return relative(ORIGINALS, file).split(sep).join("/")
}

function sortedByKey(object) {
  return Object.fromEntries(Object.entries(object).sort(([ a ], [ b ]) => a.localeCompare(b)))
}

async function eachInParallel(items, work) {
  const queue = [ ...items ]
  const workers = Array.from({ length: CONCURRENCY }, async () => {
    while (queue.length > 0) {
      await work(queue.shift())
    }
  })

  await Promise.all(workers)
}
