---
import "~/styles/app.css"
import Header from "~/components/Header.astro"
import SearchPanel from "~/components/SearchPanel.astro"
import { FEED_PATH, KIND_FEED_PATHS } from "~/lib/feed-paths"
import { absoluteUrl, titleize } from "~/lib/site"

interface Props {
  // The header's section to mark as current, for pages that belong to one
  section?: "articles" | "talks" | "snaps" | "projects"
  // The home page shows the portrait itself, so the header leaves its avatar out
  home?: boolean
  // Animate navigations between this page and others that do (doc/front-end.md)
  transitions?: boolean
}

// A navigation animates only when both pages opt in, and never with reduced motion
const VIEW_TRANSITIONS = "@view-transition { navigation: auto; } @media (prefers-reduced-motion: reduce) { @view-transition { navigation: none; } }"

const { section, home = false, transitions = false } = Astro.props

// A section's pages point feed readers at that section's feed, everything else at /feed
const SECTION_KINDS: Record<string, string> = { articles: "article", talks: "talk", snaps: "snap" }
const feedPath = KIND_FEED_PATHS[SECTION_KINDS[section ?? ""]] ?? FEED_PATH
const hasHead = Astro.slots.has("head")
const canonicalUrl = absoluteUrl(Astro.url.pathname)
const currentYear = new Date().getUTCFullYear()
---

<!DOCTYPE html>
<html lang="en" class="color-scheme">
  <head>
    <script is:inline>
      (() => {
        const COOKIE = "color_scheme"
        const EXPIRATION_PERIOD = 5 * 365 * 24 * 60 * 60 * 1000
        const darkQuery = window.matchMedia("(prefers-color-scheme: dark)")

        function storedScheme() {
          const cookie = document.cookie.split("; ").find(cookie => cookie.startsWith(`${COOKIE}=`))

          if (cookie) {
            return decodeURIComponent(cookie.split("=")[1]) || "auto"
          } else {
            return "auto"
          }
        }

        function apply(scheme) {
          const dark = scheme === "dark" || (scheme === "auto" && darkQuery.matches)

          document.documentElement.classList.toggle("color-scheme--dark", dark)
          document.documentElement.classList.toggle("color-scheme--light", !dark)
        }

        window.colorScheme = {
          get current() {
            return storedScheme()
          },

          use(scheme) {
            const expiresAt = new Date(Date.now() + EXPIRATION_PERIOD).toUTCString()
            document.cookie = `${COOKIE}=${encodeURIComponent(scheme)}; path=/; expires=${expiresAt}`
            apply(scheme)
          }
        }

        apply(storedScheme())

        darkQuery.addEventListener("change", () => {
          if (storedScheme() === "auto") {
            apply("auto")
          }
        })
      })()
    </script>
    <slot name="head" />
    {!hasHead && (
      <Fragment>
        <title>{titleize("Blog")}</title>
        <link rel="canonical" href={canonicalUrl} />
      </Fragment>
    )}
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {transitions && <style is:inline set:html={VIEW_TRANSITIONS} />}
    <link rel="alternate" type="application/atom+xml" title="ATOM" href={feedPath} />
    <link rel="apple-touch-icon" sizes="57x57" href="/apple-touch-icon-57x57.png" />
    <link rel="apple-touch-icon" sizes="60x60" href="/apple-touch-icon-60x60.png" />
    <link rel="apple-touch-icon" sizes="72x72" href="/apple-touch-icon-72x72.png" />
    <link rel="apple-touch-icon" sizes="76x76" href="/apple-touch-icon-76x76.png" />
    <link rel="apple-touch-icon" sizes="114x114" href="/apple-touch-icon-114x114.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon-120x120.png" />
    <link rel="apple-touch-icon" sizes="144x144" href="/apple-touch-icon-144x144.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#5bbad5" />
    <meta name="msapplication-TileColor" content="#2d89ef" />
    <meta name="msapplication-TileImage" content="/mstile-144x144.png" />
    <script is:inline defer data-domain="stanko.io" src="https://analytics.stanko.io/js/script.js"></script>
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="wcLak/1lJhto3qkm5/r33w" async></script>
  </head>

  <body>
    <header>
      <Header section={section} home={home} />
    </header>

    <main class="main" role="main">
      <div class="main__content">
        <slot />
      </div>
    </main>

    <footer class="footer">
      <div class="footer__links">
        <a href="https://stanko.io/">About</a>
        <a href="https://stanko.io/articles">Articles</a>
        <a href="https://stanko.io/talks">Talks</a>
        <a href="https://stanko.io/snaps">Snaps</a>
        <a href="https://github.com/monorkin/blog" target="_blank">Source code</a>
      </div>
      <div class="footer__copyright">
        © {currentYear} Stanko. All rights reserved.
      </div>
    </footer>

    <dialog id="search-dialog" class="sheet sheet--search" aria-label="Search" data-dismissable>
      <SearchPanel inDialog />
    </dialog>

    <script>
      import "~/scripts/dialogs"
      import "~/scripts/settings"
      import "~/scripts/search"
      import "~/scripts/attachments"
      import "~/scripts/placeholders"
      import "~/scripts/pagination"
    </script>
  </body>
</html>
