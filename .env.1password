# References, not secrets: `op run --account my.1password.eu --env-file=.env.1password`
# resolves them. bin/media sync and pull use this when the keys aren't already in the
# environment. doc/images.md has the 1Password item this points at.
R2_ACCESS_KEY_ID=op://Infrastructure/stanko.io/media.stanko.io/Access Key ID
R2_SECRET_ACCESS_KEY=op://Infrastructure/stanko.io/media.stanko.io/Secret Access Key
