---
import { findMedia, mediaFolderFor, originalUrl, resolveMediaKey, variantAtLeast } from "~/lib/media"

interface Props {
  media: string
  type: string
  poster?: string
  caption?: string
  // A short clip that plays like a GIF: no controls
  clip?: boolean
}

const POSTER_WIDTH = 1200

const { type, caption = "", clip = false } = Astro.props
const folder = mediaFolderFor(Astro)
const media = resolveMediaKey(Astro.props.media, folder)
const extension = media.split(".").pop()!.toLowerCase()
const video = findMedia(media)

let posterUrl
if (Astro.props.poster) {
  posterUrl = variantAtLeast(resolveMediaKey(Astro.props.poster, folder), POSTER_WIDTH)
}
---

<figure class={`attachment attachment--preview attachment--${extension}`}>
  <video controls={!clip} autoplay playsinline loop muted poster={posterUrl} width={video.width} height={video.height}>
    <source src={originalUrl(media)} type={type} />
  </video>
  <figcaption class="attachment__caption">{caption}</figcaption>
</figure>
