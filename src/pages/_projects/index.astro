---
import Layout from "~/layouts/Layout.astro"
import SeoTags from "~/components/SeoTags.astro"
import { listedProjects } from "~/lib/projects"
import { absoluteUrl, titleize } from "~/lib/site"

const projects = listedProjects()
---

<Layout section="projects">
  <Fragment slot="head">
    <title>{titleize("Projects")}</title>
    <SeoTags title="Projects" description="Projects by Stanko, a programmer from Zagreb: software and hardware built on the side, with write-ups on how each one works." url={absoluteUrl("/projects")} />
  </Fragment>

  <section class="article margin-block-end-4">
    <h1 class="txt-4xl font-semibold">Projects</h1>
  </section>

  <section>
    <ul class="entry-list">
      {projects.map(project => (
        <li class="entry-list__item">
          <a href={project.url} aria-label={project.frontmatter.title}></a>

          <div class="entry-list__title">
            {project.frontmatter.title}
          </div>

          <div class="entry-list__excerpt">
            {project.frontmatter.description}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>
