{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [ "nodejs_compat" ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Static files answer first, except the feed URLs whose query strings the Worker has to
    // read or drop (src/worker.ts); it hands anything it doesn't redirect to Astro
    "run_worker_first": [ "/feed", "/articles/atom", "/articles/rss" ]
  },
  "observability": {
    "enabled": true
  }
}
