---
import Icon from "~/components/Icon.astro"
import AppearancePicker from "~/components/AppearancePicker.astro"
import portrait from "~/assets/images/portrait/small.jpg"

const NAV_ITEMS = [
  { href: "/articles", label: "Articles" },
  { href: "/talks", label: "Talks" },
  { href: "/snaps", label: "Snaps" },
  { href: "/projects", label: "Projects" }
]

const section = NAV_ITEMS.find(item => Astro.url.pathname.startsWith(item.href))

function currentFor(item: { href: string }) {
  if (item === section) {
    return "page"
  }
}
---

<nav class="header" aria-label="Main">
  <a class="header__home" href="/" aria-label="About">
    <img class="header__profile-img profile-img" alt="Stanko K.R." src={portrait.src} />
  </a>

  <ul class="header__links">
    {NAV_ITEMS.map(item => (
      <li><a class="header__link" href={item.href} aria-current={currentFor(item)}>{item.label}</a></li>
    ))}
  </ul>

  <div class="header__actions">
    <a class="header__action" href="/search" data-search-open aria-label="Search" title="Search (/)" aria-keyshortcuts="/ Control+K Meta+K">
      <Icon name="search" class="header__icon" />
    </a>

    <button type="button" class="header__action header__appearance" popovertarget="appearance-popover" aria-label="Appearance">
      <Icon name="settings" class="header__icon" />
    </button>

    <button type="button" class="header__action header__menu-toggle" data-dialog-open="menu" aria-haspopup="dialog">
      Menu
    </button>
  </div>
</nav>

<div id="appearance-popover" class="appearance-popover" popover>
  <AppearancePicker idPrefix="popover" />
</div>

<dialog id="menu" class="sheet sheet--menu" aria-label="Menu" data-dismissable>
  <div class="menu">
    <div class="menu__bar">
      <a class="header__home" href="/" aria-label="About">
        <img class="header__profile-img profile-img" alt="" src={portrait.src} />
      </a>
      <button type="button" class="header__action" data-dialog-close>Close</button>
    </div>

    <ul class="menu__links">
      <li><a class="menu__link" href="/">About</a></li>
      {NAV_ITEMS.map(item => (
        <li><a class="menu__link" href={item.href} aria-current={currentFor(item)}>{item.label}</a></li>
      ))}
    </ul>

    <AppearancePicker idPrefix="menu" />
  </div>
</dialog>
