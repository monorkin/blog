---
import type { Entry } from "~/lib/entries"
import { findMedia, placeholderStyle, squareUrl } from "~/lib/media"
import { transitionStyles } from "~/lib/view-transitions"

interface Props {
  snap: Entry
}

const THUMBNAIL_SIZE = 400
const THUMBNAIL_SIZES = "(width >= 600px) 300px, 33vw"

const { snap } = Astro.props
const cover = snap.coverImage()!
const squares = findMedia(cover).squares ?? []
const srcset = squares.map(size => `${squareUrl(cover, size, "webp")} ${size}w`).join(", ")
const placeholder = placeholderStyle(cover)
const duration = snap.videoDuration()

function formatDuration(totalSeconds: number) {
  const seconds = Math.round(totalSeconds)
  return `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, "0")}`
}
---

<div class="photos-grid__item" data-snap-tilt>
  <a href={snap.path} class:list={[ "photos-grid__button", { placeholder } ]} style={placeholder} data-snap-lightbox>
    <img
      src={squareUrl(cover, THUMBNAIL_SIZE, "webp")}
      srcset={srcset}
      sizes={THUMBNAIL_SIZES}
      width={THUMBNAIL_SIZE}
      height={THUMBNAIL_SIZE}
      alt={snap.title}
      class="photos-grid__image"
      style={transitionStyles(snap).image}
      loading="lazy"
    />
  </a>
  {duration && (
    <span class="photos-grid__duration">{formatDuration(duration)}</span>
  )}
</div>
