---
import Layout from "~/layouts/Layout.astro"
import AppearancePicker from "~/components/AppearancePicker.astro"
import { titleize } from "~/lib/site"
---

<Layout>
  <Fragment slot="head">
    <title>{titleize("Settings")}</title>
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="settings-page">
    <h1 class="settings-page__title">Settings</h1>
    <AppearancePicker idPrefix="page" />
  </div>
</Layout>
