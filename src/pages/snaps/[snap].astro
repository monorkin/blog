---
import type { GetStaticPaths } from "astro"
import type { CollectionEntry } from "astro:content"
import Layout from "~/layouts/Layout.astro"
import EntrySeoTags from "~/components/EntrySeoTags.astro"
import Icon from "~/components/Icon.astro"
import { publishedEntries, type Entry } from "~/lib/entries"
import { findMedia, originalUrl, placeholderStyle, sources, variantAtLeast } from "~/lib/media"
import { isoTimestamp } from "~/lib/site"
import { transitionStyles } from "~/lib/view-transitions"

export const getStaticPaths = (async () => {
  const snaps = await publishedEntries("snap")

  return snaps.map((snap, index) => ({
    params: { snap: snap.id },
    props: { snap, previousSnap: snaps[index - 1], nextSnap: snaps[index + 1] }
  }))
}) satisfies GetStaticPaths

interface Props {
  snap: Entry
  previousSnap?: Entry
  nextSnap?: Entry
}

const LIGHTBOX_SIZES = "100vw"
const LIGHTBOX_FALLBACK_WIDTH = 1600

const { snap, previousSnap, nextSnap } = Astro.props
const data = snap.source.data as CollectionEntry<"snaps">["data"]
const imageName = transitionStyles(snap).image

let image
let original
if (data.image) {
  const key = snap.mediaKey(data.image)
  const imageSources = sources(key)
  image = { entry: findMedia(key), extraSources: imageSources.slice(0, -1), fallback: imageSources.at(-1), src: variantAtLeast(key, LIGHTBOX_FALLBACK_WIDTH), placeholder: placeholderStyle(key) }
  original = originalUrl(key)
}

let video
if (data.video) {
  const key = snap.mediaKey(data.video)
  const videoMedia = findMedia(key)
  const posterKey = snap.posterKey()!
  video = {
    url: originalUrl(key),
    type: data.videoType ?? videoMedia.type,
    width: videoMedia.width,
    height: videoMedia.height,
    poster: variantAtLeast(posterKey, LIGHTBOX_FALLBACK_WIDTH),
    placeholder: placeholderStyle(posterKey)
  }
  original = video.url
}
---

<Layout section="snaps" transitions>
  <EntrySeoTags slot="head" entry={snap} />

  <div id="snap_lightbox" class="snap-page">
    <div class="lightbox__content">
      <a href="/snaps" class="lightbox__close" data-dialog-close aria-label="Close">&times;</a>

      {previousSnap && (
        <a href={previousSnap.path} class="lightbox__nav lightbox__nav--prev" data-snap-previous aria-label="Previous">
          &lsaquo;
        </a>
      )}

      {image && (
        <picture>
          {image.extraSources.map(source => <source type={source.type} srcset={source.srcset} sizes={LIGHTBOX_SIZES} />)}
          <img
            src={image.src}
            srcset={image.fallback?.srcset}
            sizes={LIGHTBOX_SIZES}
            width={image.entry.width}
            height={image.entry.height}
            alt={snap.title}
            class:list={[ "lightbox__image", { placeholder: image.placeholder } ]}
            style={`${imageName}; ${image.placeholder ?? ""}`}
          />
        </picture>
      )}
      {video && (
        <video class:list={[ "lightbox__image", { placeholder: video.placeholder } ]} style={`${imageName}; ${video.placeholder || ""}`} controls poster={video.poster} width={video.width} height={video.height}>
          <source src={video.url} type={video.type} />
        </video>
      )}

      {nextSnap && (
        <a href={nextSnap.path} class="lightbox__nav lightbox__nav--next" data-snap-next aria-label="Next">
          &rsaquo;
        </a>
      )}

      <div class="lightbox__footer">
        <div class="lightbox__captions" data-pagefind-body data-pagefind-meta="type:Snap">
          <h1 class="lightbox__caption" data-pagefind-meta="title">{snap.title}</h1>
          <time hidden datetime={isoTimestamp(snap.publishedAt)} data-pagefind-meta="date[datetime]"></time>
          {data.caption && <span class="lightbox__caption">{data.caption}</span>}
        </div>

        <div class="lightbox__actions" data-snap-actions>
          <button class="lightbox__action-btn" data-copy-link={snap.url} aria-label="Copy link" title="Copy link">
            <Icon name="link" class="icon-sm" />
          </button>

          {original && (
            <a href={original} class="lightbox__action-btn" aria-label="Download original" title="Download original" download>
              <Icon name="arrow-down-tray" class="icon-sm" />
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  <script>
    import "~/scripts/snaps"
  </script>
</Layout>
