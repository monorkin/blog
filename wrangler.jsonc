{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [ "nodejs_compat" ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Static files answer first, except the feeds' own URLs, whose first page the Worker
    // serves, and the old feed URLs it redirects (src/worker.ts)
    "run_worker_first": [ "/feed", "/articles/feed", "/talks/feed", "/snaps/feed", "/articles/atom", "/articles/rss" ]
  },
  "observability": {
    "enabled": true
  }
}
