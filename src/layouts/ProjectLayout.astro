---
import Layout from "~/layouts/Layout.astro"
import SeoTags from "~/components/SeoTags.astro"
import Icon from "~/components/Icon.astro"
import { absoluteUrl, titleize } from "~/lib/site"

interface Props {
  frontmatter: {
    title: string
    description: string
  }
}

const { frontmatter } = Astro.props
---

<Layout>
  <Fragment slot="head">
    <title>{titleize(frontmatter.title)}</title>
    <SeoTags title={frontmatter.title} description={frontmatter.description} url={absoluteUrl(Astro.url.pathname)} />
  </Fragment>

  <article class="article">
    <div class="flex flex-row gap-x-4">
      <span><a class="article__back-link" href="/projects"><span class="inline-flex flex-row items-center gap-x-2 "><Icon name="arrow-long-left" />Back</span></a></span>
    </div>

    <h1 class="article__title">{frontmatter.title}</h1>

    <div class="lexxy-content">
      <slot />
    </div>
  </article>
</Layout>
