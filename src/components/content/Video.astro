---
import { findMedia, originalUrl, variantAtLeast } from "~/lib/media"

interface Props {
  media: string
  type: string
  poster?: string
  caption?: string
}

const POSTER_WIDTH = 1200

const { media, type, poster, caption = "" } = Astro.props
const extension = media.split(".").pop()!.toLowerCase()
const video = findMedia(media)

let posterUrl
if (poster) {
  posterUrl = variantAtLeast(poster, POSTER_WIDTH)
}
---

<figure class={`attachment attachment--preview attachment--${extension}`}>
  <video controls autoplay playsinline loop muted poster={posterUrl} width={video.width} height={video.height}>
    <source src={originalUrl(media)} type={type} />
  </video>
  <figcaption class="attachment__caption">{caption}</figcaption>
</figure>
