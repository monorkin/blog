---
import type { GetStaticPaths } from "astro"
import Layout from "~/layouts/Layout.astro"
import SeoTags from "~/components/SeoTags.astro"
import EntryList from "~/components/EntryList.astro"
import Paginated from "~/components/Paginated.astro"
import { publishedTalks, type Entry } from "~/lib/entries"
import { paginateIndex, type IndexPage } from "~/lib/pagination"
import { absoluteUrl, titleize } from "~/lib/site"

export const getStaticPaths = (async ({ paginate }) => {
  return paginateIndex(paginate, await publishedTalks(), "/talks")
}) satisfies GetStaticPaths

const { page } = Astro.props as { page: IndexPage<Entry> }
const listClasses = [ "flex flex-col", page.first && "timeline--first", page.last && "timeline--last" ].filter(Boolean).join(" ")
---

<Layout>
  <Fragment slot="head">
    <title>{titleize("Talks")}</title>
    <SeoTags
      title="Talks"
      description="Conference talks and presentations about Ruby, Rails, and web development"
      url={absoluteUrl("/talks")}
    />
  </Fragment>

  <div class="flex flex-col gap-y-6">
    <section class="article margin-block-end-4">
      <h1 class="txt-4xl font-semibold">Talks</h1>
    </section>

    <Paginated page={page}>
      <EntryList entries={page.data} class={listClasses} />
    </Paginated>
  </div>
</Layout>
