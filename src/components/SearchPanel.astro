---
import Icon from "~/components/Icon.astro"

interface Props {
  inDialog?: boolean
}

const { inDialog = false } = Astro.props

let resultsId = "search-page-results"
if (inDialog) {
  resultsId = "search-dialog-results"
}
---

<div class:list={[ "search", { "search--page": !inDialog } ]} data-search>
  <form class="search__bar" action="/search" method="get" role="search" data-search-form>
    <Icon name="search" class="search__icon" />
    <input
      type="search"
      name="search[term]"
      class="search__input"
      placeholder="Search"
      aria-label="Search"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls={resultsId}
      aria-autocomplete="list"
      autofocus={inDialog}
      data-search-input
    />
    {inDialog && (
      <button type="button" class="search__close" data-dialog-close>
        <kbd class="kbd search__close-key">Esc</kbd>
        <span class="search__close-label">Close</span>
      </button>
    )}
  </form>

  <p class="search__status" aria-live="polite" data-search-status></p>
  <ul class="search__results" id={resultsId} role="listbox" aria-label="Results" data-search-results></ul>

  <template data-search-result-template>
    <li class="search__result" role="option" aria-selected="false">
      <a class="search__result-link" href="" tabindex="-1">
        <span class="search__result-heading">
          <span class="search__result-title" data-title></span>
          <span class="search__result-kind" data-kind></span>
          <time class="search__result-date" data-date></time>
        </span>
        <span class="search__result-excerpt" data-excerpt></span>
      </a>
    </li>
  </template>
</div>
